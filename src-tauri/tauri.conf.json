{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Carteiro",
  "version": "0.1.0",
  "identifier": "dev.carteiro.mail",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Carteiro",
        "width": 1280,
        "height": 820,
        "minWidth": 360,
        "minHeight": 520,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data: blob: https:; style-src 'self' 'unsafe-inline'; frame-src 'self' blob: data:; script-src 'self'"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "minSdkVersion": 28
    },
    "linux": {
      "appimage": {
        "files": {
          "/usr/share/carteiro/fonts/NotoColorEmoji.ttf": "fonts/NotoColorEmoji.ttf"
        }
      }
    }
  }
}
